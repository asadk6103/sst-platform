# Optional. Docker installs need no .env file: the first visit to /admin/ runs a setup wizard,
# security keys are generated automatically, and settings are managed in the admin portal.
#
# Only these infrastructure values can be overridden here:

# Port on this machine that serves the site (default 8000)
# HTTP_PORT=8000

# Database password. Only read when the database volume is FIRST created; changing it later
# requires changing it inside PostgreSQL too. The database is reachable only inside the stack.
# POSTGRES_PASSWORD=choose-a-long-random-password

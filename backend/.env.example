# Local development only (running the API with `npm run dev` outside Docker).
# Docker installs need no .env: security keys are generated on first start and everything
# else is configured in the administration portal (first-run setup wizard, then System).
NODE_ENV=development
PORT=4200
DATABASE_URL=postgresql://sst:sst_dev_password@localhost:5433/sst?schema=public
CONFIG_DIR=./config
UPLOAD_DIR=./uploads
REVALIDATE_URL=http://localhost:3000/cms-hooks/revalidate

# Optional overrides of values normally managed in Administration → System:
# PUBLIC_URL=http://localhost:3000
# MAX_UPLOAD_MB=15
# COOKIE_SECURE=auto
# Optional: pre-create the first administrator for unattended installs (skips the wizard)
# SEED_ADMIN_EMAIL=admin@example.org
# SEED_ADMIN_PASSWORD=ChangeThis!2026

{
  "name": "sst-platform",
  "private": true,
  "version": "1.0.0",
  "description": "SST Public School Rashidabad — public website, administration portal and CMS backend",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend/*"
  ],
  "scripts": {
    "up": "docker compose up -d --build",
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f --tail=100",
    "ps": "docker compose ps",
    "seed:reset": "docker compose exec api sh -c \"node dist/seed.js --reset 2>/dev/null || npx tsx prisma/seed.ts --reset\" && docker compose restart api",
    "local:api": "npm run dev -w backend",
    "build": "npm run build -w backend",
    "test": "npm run test -w backend",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@scarf/scarf": false,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
